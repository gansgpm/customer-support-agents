# Copy this file to .env and fill in what you use. Never commit .env.

# ---------- LLM ----------------------------------------------------------
# openai | azure | gemini | groq | ollama | offline (offline = rule-based demo, no key)
LLM_PROVIDER=openai
# leave empty for the default model of the provider
#   openai: gpt-4o-mini   gemini: gemini-2.5-flash   groq: llama-3.3-70b-versatile   ollama: qwen2.5:7b
LLM_MODEL=
LLM_TEMPERATURE=0.1
LLM_MAX_RETRIES=3               # retry rate limits / timeouts / 5xx with back-off
LLM_TIMEOUT=60                  # seconds per LLM call
GROUNDING_VERIFIER=auto          # auto|llm|off: an LLM checks every claim of the reply against the passages
STREAM_REPLIES=true             # show the reply in the UI while the Resolution Agent writes it
LOG_LEVEL=INFO                  # logs/app.log (rotating) + logs/traces.jsonl (one line per ticket)

OPENAI_API_KEY=your-key-here
# GEMINI_API_KEY=
# GROQ_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-10-21

# ---------- Orchestration & escalation -----------------------------------
# round_robin (fixed order) | selector (model picks the next agent)
ORCHESTRATION_MODE=round_robin
# per division group; the desk adds a few messages for the Support Manager
MAX_MESSAGES=10
# escalate when the Resolution Agent's confidence is below this (also the bar for feeding the KB)
CONFIDENCE_THRESHOLD=80
# sentiment score at or below which an Angry customer counts as "very angry"
VERY_ANGRY_SCORE=-0.5
# holding = customer gets an acknowledgement, AI draft waits for human approval
# send    = AI reply is sent with an escalation note
ESCALATED_REPLY_MODE=holding
LEARNING_ENABLED=true
# stop greetings, spam, abuse, prompt injection, gibberish, duplicates and off-topic messages; mask card numbers / OTPs
GUARDRAILS_ENABLED=true
FOLLOWUP_WINDOW_DAYS=7          # a short / "any update?" message from the same customer within N days continues their ticket

# ---------- RAG ----------------------------------------------------------
# tfidf (offline, default) | openai (text-embedding-3-small, multilingual) |
# sentence-transformers (paraphrase-multilingual-MiniLM-L12-v2: Tamil, Hindi and 50+ languages)
EMBEDDING_BACKEND=tfidf
EMBEDDING_MODEL=
# 'covered' decision thresholds: auto = calibrated for the embedding backend (evaluation/calibration/<backend>.json,
# written by: python -m evaluation.retrieval_eval --calibrate). Put a number to override.
KB_MIN_RELEVANCE=auto
KB_MIN_COVERAGE=auto            # share of the question's key words the passages must contain to count as covered
KB_STRONG_RELEVANCE=auto        # a semantic match this close counts as covered with less key-word overlap
KB_TOP_K=4                      # passages handed to the agent
KB_CANDIDATES=12                # fused BM25 + vector pool handed to the reranker
RRF_K=60                        # reciprocal rank fusion constant
# Reranker after fusion: feature (offline, default) | cross-encoder (multilingual BAAI/bge-reranker-v2-m3,
# needs: pip install sentence-transformers) | none
RERANKER=feature
RERANKER_MODEL=

# ---------- Company ------------------------------------------------------
COMPANY_NAME=Remya Industries Ltd
SUPPORT_SIGNATURE=Remya Industries Ltd Customer Support

# ---------- Email (Gmail: enable IMAP + use an App Password) --------------
# Use a SEPARATE Gmail account for the desk: every unread customer mail in its inbox becomes a ticket.
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=465
EMAIL_FORCE_IPV4=false        # true if Gmail drops the connection over IPv6 on your network (see email_diagnose)
# Which mails become tickets. Default (both empty/false): ONLY replies to the desk's own tickets ([TKT-...] in the
# subject) - safe even on a personal mailbox. EMAIL_SUBJECT_FILTER=Support also accepts new mails whose subject
# contains "Support". EMAIL_MAILBOX_DEDICATED=true accepts EVERY unread mail - only for a Gmail used just by the desk.
EMAIL_SUBJECT_FILTER=
EMAIL_MAILBOX_DEDICATED=false
EMAIL_LOOKBACK_DAYS=2           # only unread mail from the last N days becomes a ticket (old backlog is ignored)

# ---------- Telegram (create a bot with @BotFather) ------------------------
TELEGRAM_BOT_TOKEN=

# ---------- WhatsApp (Twilio sandbox or approved sender) ------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ---------- Human support notifications on escalation ---------------------
# Shared fallback inbox / chat for every desk
SUPPORT_TEAM_EMAIL=
SUPPORT_TELEGRAM_CHAT_ID=
# Optional per-desk contacts (names come from knowledge_base/catalog.json)
TEAM_GENERAL_EMAIL=
TEAM_ELECTRONICS_EMAIL=
TEAM_APPLIANCES_EMAIL=
TEAM_FASHION_EMAIL=
TEAM_GROCERY_EMAIL=
TEAM_REMYACARE_EMAIL=
TEAM_REMYASHIELD_EMAIL=
TEAM_PLUS_EMAIL=
TEAM_TRUST_SAFETY_EMAIL=
TEAM_BILLING_EMAIL=
TEAM_RELATIONS_EMAIL=
# ...and the same with _TELEGRAM for a Telegram chat id per desk, e.g. TEAM_GROCERY_TELEGRAM=

# ---------- Channel worker / webhook ---------------------------------------
WORKER_POLL_SECONDS=20
AUTO_PROCESS=false
